server {
    # 容器内用 8080 而非 80：镜像以非 root 用户（uid 101）运行，
    # 而 1024 以下的端口是特权端口，非 root 无权绑定，会直接
    # "Permission denied" 起不来。宿主侧用 -p 8080:8080 映射即可。
    listen       8080;
    server_name  _;

    # 日志在主配置 nginx.conf 里已指向 /dev/stdout 与 /dev/stderr，
    # 这里不再重复声明
    root  /usr/share/nginx/html;
    index index.html;

    # ---------------------------------------------------------------------
    # 后端地址由容器启动时的环境变量注入：
    #   docker run -e BACKEND_URL=http://backend:8080 ...
    # 或在 docker-compose.yml 的 environment 里配。
    # nginx 官方镜像启动时会对 /etc/nginx/templates/*.template 执行 envsubst，
    # 下面 ${BACKEND_URL} 会被替换成实际地址。
    #
    # 这里直接替换进 proxy_pass（而不是 nginx 变量），是为了让 nginx 在
    # 加载配置时就解析一次后端主机名 —— 若写成 proxy_pass $var，主机名会
    # 变成运行时解析，必须额外配 resolver 指令，脱离 Docker 环境就不可用。
    #
    # 注意 BACKEND_URL 要带完整的 scheme（http://host:port），模板里不再
    # 写死 http:// 前缀 —— 之前两边都带，渲染出 http://http://… 导致
    # nginx 报 invalid port in upstream。
    #
    # 路径与 config/config.proxy.ts 的 dev 代理规则保持一致：/api、/web、/version。
    # 刻意不加 /gpu 前缀规则 —— 实时数据已迁移到同源聚合层，前端不再直连
    # agent，那条规则会把前端路由 /gpu-dashboard 一起拐到后端导致 404。
    # ---------------------------------------------------------------------

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_comp_level   6;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/xml image/svg+xml
                      font/woff font/woff2;

    # proxy_pass 末尾不带 URI 部分，请求路径原样透传给后端。
    # （dev 代理里 pathRewrite 去掉前缀再拼回 target 的 '/api/'，净效果也是透传。）

    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # 实时数据是长连接/轮询，关掉缓冲并放宽读超时
        proxy_buffering    off;
        proxy_read_timeout 300s;
    }

    location /web/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_buffering    off;
        proxy_read_timeout 300s;
    }

    # 反馈报告页读后端的版本号；dev 下不补这条会拿到 dev server 的 SPA HTML
    location = /version {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }

    # 带 hash 的静态资源：可长期缓存
    location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|ico|webp)$ {
        expires    1y;
        add_header Cache-Control "public, immutable";
        try_files  $uri =404;
    }

    # index.html 绝不缓存，否则发版后用户拿到旧壳子配新资源，白屏
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # SPA history 路由 fallback：
    # 访问 /gpu-dashboard 这类前端路由时直接 404，必须回落到 index.html，
    # 否则用户刷新页面就挂了。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
