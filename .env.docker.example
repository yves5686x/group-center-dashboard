# 复制为 .env.docker.local，填写真实凭据；此文件是无密钥模板。
# 已有远端数据库：保持你本机可连通的 IP/域名（可能需要 VPN）。
# 数据库在 Mac 宿主机：用 host.docker.internal，不用 localhost。
LOCAL_DATABASE_URL='jdbc:mysql://172.22.22.1:3306/group_center?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai'
LOCAL_DATABASE_USERNAME=root
LOCAL_DATABASE_PASSWORD=
LOCAL_AGENT_BASE_URL=http://g.329509.xyz
LOCAL_MACHINE_CONFIG=./Config/Machine/real.yaml
LOCAL_SITE_CONFIG=./Config/Dashboard/Site/real.yaml
# 有真实用户配置才填此项；留空时高级管理用户列表为空。
LOCAL_USER_CONFIG=
WEB_PORT=8080
BACKEND_PORT=15090
